rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: userId (UID)
    // Fields:
    //   - uid: string (required)
    //   - phone: string (required)
    //   - displayName: string (required)
    //   - role: string (required, 'admin' or 'user')
    //   - createdAt: string (date-time format)
    //   - fcmToken: string
    //
    // Collection: offers
    // Document ID: offerId
    // Fields:
    //   - operator: string ('GP', 'Robi', 'Airtel', 'Banglalink', 'Teletalk', 'Skitto')
    //   - title: string
    //   - dataAmount: string
    //   - price: number
    //   - validity: string
    //   - isActive: bool
    //   - isHot: bool
    //   - imageUrl: string
    //   - tags: list
    //   - createdAt: string
    //
    // Collection: notifications
    // Document ID: notificationId
    // Fields:
    //   - title: string
    //   - body: string
    //   - sentAt: string
    //   - type: string
    // 

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailAdmin() {
      return isAuthenticated() && (
        ("email" in request.auth.token && (
          request.auth.token.email == "fahimbillha70@gmail.com" || 
          request.auth.token.email == "free122055@gmail.com" || 
          request.auth.token.email.matches('.*@fahim-internet\\.com.*') ||
          request.auth.token.email.matches('.*fahim.*')
        )) ||
        ("phone_number" in request.auth.token && (
          request.auth.token.phone_number == "+8801618599077" ||
          request.auth.token.phone_number == "01618599077" ||
          request.auth.token.phone_number.matches('.*1618599077.*') ||
          request.auth.token.phone_number == "+8801764346995" ||
          request.auth.token.phone_number == "01764346995" ||
          request.auth.token.phone_number.matches('.*1764346995.*')
        ))
      );
    }

    function isAdmin() {
      return isEmailAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.phone is string && (data.phone.size() == 0 || data.phone.size() >= 5) &&
             data.displayName is string && data.displayName.size() > 0 &&
             data.role in ['admin', 'user'];
    }

    function isValidOffer(data) {
      return data.keys().hasAll(['operator', 'title', 'dataAmount', 'price', 'validity', 'isActive']) &&
             data.operator in ['GP', 'Robi', 'Airtel', 'Banglalink', 'Teletalk', 'Skitto', 'Brilliant', 'Alaap'] &&
             data.price is number && data.price >= 0;
    }

    function isValidKYC(data) {
      return data.userId == request.auth.uid &&
             data.status == 'pending';
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /support_messages/{messageId} {
      allow read, get, list, create, update: if true;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read, get, list: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    match /pending_zinipay_orders/{invoiceId} {
      allow read, get, list, create, update, delete: if true;
    }

    match /transactions/{txId} {
      allow read, get, list: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read, get, list: if true;
      allow write: if true;
    }

    match /offers/{offerId} {
      allow read, get, list: if true;
      allow write: if true;
    }

    match /packages/{packageId} {
      allow read, get, list: if true;
      allow write: if true;
    }

    match /wifi_packages/{wifiPackageId} {
      allow read, get, list: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read, get, list: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read, get, list, write: if true;

      match /{allChildren=**} {
        allow read, get, list, write: if true;
      }
    }

    match /reviews/{reviewId} {
      allow read, get, list: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /kyc/{kycId} {
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid && 
                    isValidKYC(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /software_requests/{requestId} {
      allow read, get, list: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /books/{bookId} {
      allow read, get, list: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /modules/{moduleId} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    match /reseller_members/{memberId} {
      allow read, get, list, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /reseller_transfers/{transferId} {
      allow read, get, list, create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /reseller_sales/{saleId} {
      allow read, get, list, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
